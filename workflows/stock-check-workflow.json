    {
      "parameters": {
        "jsCode": "let stockData       = [];\nlet inPurchaseItems = [];\nlet sentItems       = [];\n\ntry { stockData       = $('Get All Stock').all().map(i => i.json);            } catch(e) {}\ntry { inPurchaseItems = $('Get In-Purchase Items').all().map(i => i.json);    } catch(e) {}\ntry { sentItems       = $('Get Quotation Sent Items').all().map(i => i.json); } catch(e) {}\n\nif (!Array.isArray(stockData))       stockData       = stockData?.data       ?? [];\nif (!Array.isArray(inPurchaseItems)) inPurchaseItems = inPurchaseItems?.data ?? [];\nif (!Array.isArray(sentItems))       sentItems       = sentItems?.data       ?? [];\n\nif (stockData.length === 0) {\n  console.log('[StockCheck-ALL] No stock data returned.');\n  return [{ json: { items: [], items_found: false, reason: 'no_stock_data' } }];\n}\n\nconst inPurchaseIcodes = new Set(inPurchaseItems.map(i => Number(i.icode)));\nconst sentIcodes = new Set(\n  sentItems.filter(i => i.quotation_sent === true).map(i => Number(i.icode))\n);\n\nconst result   = [];\nconst addedSet = new Set();\n\nfor (const stock of stockData) {\n  const icode        = Number(stock.icode);\n  const availableQty = Number(stock.available_qty    ?? 0);\n  const min          = Number(stock.minimum_threshold ?? 0);\n\n  if (inPurchaseIcodes.has(icode)) continue;\n  if (sentIcodes.has(icode))       continue;\n  if (addedSet.has(icode))         continue;\n\n  if (availableQty <= min) {\n    const required_to_reach_min = Math.ceil((min - availableQty) * 100) / 100;\n    if (required_to_reach_min <= 0) continue;\n\n    result.push({\n      icode,\n      item_name            : stock.iname ?? stock.item_name ?? `Item ${icode}`,\n      required_to_reach_min,\n      uom                  : stock.uom ?? 'PCS',\n      available_qty        : availableQty,\n      minimum_threshold    : min,\n      sono                 : null,\n      soid                 : null\n    });\n    addedSet.add(icode);\n  }\n}\n\nconst items_found = result.length > 0;\nconsole.log(`[StockCheck-ALL] ${result.length} low-stock items found. items_found=${items_found}`);\n\nreturn [{ json: { items: result, items_found, reason: items_found ? 'low_stock_items_found' : 'all_stock_sufficient' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
